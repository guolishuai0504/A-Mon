# 钉钉 / 阿里钉 自定义机器人 Webhook 完整地址（勿提交真实值）
# 对外钉钉示例: https://oapi.dingtalk.com/robot/send?access_token=xxx
# 阿里钉：在群里添加「自定义机器人」后复制 Webhook（域名可能是 alibaba-inc 等）
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=替换为你的token

# 若机器人启用了「加签」，填写密钥；仅用关键词时可留空
DINGTALK_SECRET=

# 安全关键词须出现在消息正文中（与机器人设置一致）
DINGTALK_KEYWORD=尾盘

# true=只打印不推送，便于本地调试
DRY_RUN=true
